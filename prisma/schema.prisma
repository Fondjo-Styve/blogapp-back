datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

model Post {
  id          String   @id @default(uuid())
  title       String   @unique // Added @unique here since titles must be unique!
  description String   // 👈 Added this missing field
  content     String?
  published   Boolean  @default(true) // Set to true by default per your business rule!
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("posts")
}